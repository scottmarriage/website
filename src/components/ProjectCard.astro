---
import { FaGithub, FaExternalLinkAlt } from "react-icons/fa";
import StatusBadge from "./StatusBadge.astro";

const { project } = Astro.props;
const { title, description, tech, github, demo, status, image } = project.data;
const initial = title.trim().charAt(0).toUpperCase();
---
<article class="group card flex flex-col overflow-hidden transition-shadow hover:shadow-card-hover">
  <div class="relative flex h-36 items-center justify-center overflow-hidden bg-gradient-to-br from-brand-500/15 via-brand-700/10 to-transparent">
    {image ? (
      <img src={image} alt="" class="h-full w-full object-cover" />
    ) : (
      <span class="font-display text-5xl font-semibold text-brand-500/40">{initial}</span>
    )}
  </div>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-display text-lg font-semibold text-ink">
        <a href={`/projects/${project.slug}/`} class="hover:text-brand-500">
          {title}
        </a>
      </h3>
      <StatusBadge status={status} />
    </div>
    <p class="text-sm text-ink-muted">{description}</p>
    <div class="mt-auto flex flex-wrap gap-2 pt-2">
      {(tech || []).map((t: string) => (
        <span class="rounded-full border border-border bg-surface-subtle px-2 py-0.5 font-mono text-xs text-ink-muted">
          {t}
        </span>
      ))}
    </div>
    {(github || demo) && (
      <div class="flex gap-4 border-t border-border pt-3 text-sm">
        {github && (
          <a href={github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-ink-muted hover:text-brand-500">
            <FaGithub /> Code
          </a>
        )}
        {demo && (
          <a href={demo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-ink-muted hover:text-brand-500">
            <FaExternalLinkAlt size={12} /> Live demo
          </a>
        )}
      </div>
    )}
  </div>
</article>
