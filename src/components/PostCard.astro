---
const { post } = Astro.props;
const tags = Array.isArray(post.data.tags) ? post.data.tags : [];

function fmt(d?: string | Date) {
  if (!d) return "";
  const dt = new Date(d);
  return dt.toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" });
}
---
<li
  class="card relative p-5"
  data-tags={tags.map((t: string) => t.toLowerCase().trim()).join(" ")}
>
  {post.data.date && (
    <span class="absolute right-5 top-5 font-mono text-xs text-ink-faint">{fmt(post.data.date)}</span>
  )}
  <a class="block pr-24 font-display font-semibold text-ink hover:text-brand-500" href={`/posts/${post.slug}/`}>
    {post.data.title}
  </a>
  {post.data.description && <p class="mt-1 pr-24 text-sm text-ink-muted">{post.data.description}</p>}
  {tags.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-2">
      {tags.map((t: string) => (
        <span class="rounded-full border border-border bg-surface-subtle px-2 py-0.5 font-mono text-[11px] text-ink-muted">
          {t}
        </span>
      ))}
    </div>
  )}
</li>
