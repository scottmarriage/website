---
import * as SiIcons from "react-icons/si";
import { skills, categoryLabels, type SkillCategory } from "../data/skills";

const { categories } = Astro.props as { categories?: SkillCategory[] };
const order: SkillCategory[] = categories ?? ["cloud-infra", "data-ml", "languages", "frontend", "tools"];
---
<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
  {order.map((category) => {
    const items = skills.filter((s) => s.category === category);
    if (items.length === 0) return null;
    return (
      <div>
        <h3 class="font-mono text-xs uppercase tracking-widest text-ink-faint">{categoryLabels[category]}</h3>
        <ul class="mt-3 flex flex-wrap gap-2">
          {items.map((skill) => {
            const Icon = (SiIcons as any)[skill.icon];
            return (
              <li class="flex items-center gap-2 rounded-lg border border-border bg-surface-elevated px-3 py-1.5 text-sm text-ink">
                {Icon && <Icon size={14} class="text-brand-500" />}
                {skill.name}
              </li>
            );
          })}
        </ul>
      </div>
    );
  })}
</div>
