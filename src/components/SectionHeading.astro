---
const { eyebrow, title, description, align = "left" } = Astro.props;
const alignClass = align === "center" ? "text-center mx-auto" : "text-left";
---
<div class={`max-w-2xl ${alignClass}`}>
  {eyebrow && (
    <p class="font-mono text-xs uppercase tracking-widest text-brand-500">{eyebrow}</p>
  )}
  <h2 class="mt-2 font-display text-h1 font-semibold text-ink">{title}</h2>
  {description && <p class="mt-3 text-ink-muted">{description}</p>}
</div>
