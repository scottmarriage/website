---
import Base from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
const posts = await getCollection("posts");
---
<Base title="Posts">
  <h1 class="text-3xl font-bold mb-6">Posts</h1>
  {posts.length === 0 ? (
    <p class="text-slate-400">No posts yet.</p>
  ) : (
    <ul class="space-y-4">
      {posts.map((p) => (
        <li class="card p-4">
          <a class="font-semibold" href={`/posts/${p.slug}/`}>{p.data.title}</a>
          {p.data.description && (
            <p class="text-slate-400 text-sm">{p.data.description}</p>
          )}
        </li>
      ))}
    </ul>
  )}
</Base>