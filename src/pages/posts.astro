---
import Base from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

// Load posts and sort newest first (optional)
const posts = (await getCollection("posts")).sort((a, b) => {
  const da = a.data.date ? new Date(a.data.date as any).getTime() : 0;
  const db = b.data.date ? new Date(b.data.date as any).getTime() : 0;
  return db - da;
});

// Collect unique tags
const allTags = Array.from(
  new Set(
    posts.flatMap((p) => Array.isArray(p.data.tags) ? p.data.tags : [])
  )
).sort();

function fmt(d?: string | Date) {
  if (!d) return "";
  const dt = new Date(d);
  // You can tweak locale/options if you want
  return dt.toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" });
}
---
<Base title="Posts">
  <h1 class="text-3xl font-bold mb-4">Posts</h1>

  <!-- Tag Filter Controls -->
  {allTags.length > 0 && (
    <div class="mb-6">
      <div class="text-sm text-slate-300 mb-2">Filter by tag:</div>
      <div id="tag-controls" class="flex flex-wrap gap-2">
        {allTags.map((t) => (
          <label class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-slate-700 bg-slate-900/50 cursor-pointer hover:border-slate-600">
            <input type="checkbox" value={t} class="tag-filter accent-brand h-4 w-4" />
            <span class="text-xs">{t}</span>
          </label>
        ))}
      </div>
    </div>
  )}

  {posts.length === 0 ? (
    <p class="text-slate-400">No posts yet.</p>
  ) : (
    <ul id="post-list" class="space-y-4">
      {posts.map((p) => {
        const tags = Array.isArray(p.data.tags) ? p.data.tags : [];
        return (
            <li
              class="relative card p-4"
              data-tags={(Array.isArray(p.data.tags) ? p.data.tags : [])
                .map((t) => t.toLowerCase().trim())
                .join(" ")}
            >
            <!-- Date badge (top-right) -->
            {p.data.date && (
              <span class="absolute top-3 right-4 text-xs text-slate-400">
                {fmt(p.data.date)}
              </span>
            )}

            <!-- Title -->
            <a class="font-semibold pr-24 block hover:text-brand" href={`/posts/${p.slug}/`}>
              {p.data.title}
            </a>

            <!-- Description (optional) -->
            {p.data.description && (
              <p class="text-slate-400 text-sm mt-1 pr-24">{p.data.description}</p>
            )}

            <!-- Visible tags under each card (optional) -->
            {tags.length > 0 && (
              <div class="mt-3 flex gap-2 flex-wrap">
                {tags.map((t) => (
                  <span class="px-2 py-0.5 text-[11px] rounded-full bg-slate-800/80 border border-slate-700">
                    {t}
                  </span>
                ))}
              </div>
            )}
          </li>
        );
      })}
    </ul>
  )}

  <!-- Tiny client-side filter -->
  <script is:inline>
    const checks = Array.from(document.querySelectorAll('.tag-filter'));
    const list = document.getElementById('post-list');

    const norm = (s) => (s || '').toLowerCase().trim();

    function currentTags() {
      return checks
        .filter(c => c.checked)
        .map(c => norm(c.value))
        .filter(Boolean);
    }

    function getPostTags(li) {
      // space-separated, already lowercased in the attribute
      const s = li.dataset.tags || '';
      return s.split(/\s+/).filter(Boolean);
    }

    const MODE = 'OR'; // change to 'OR' if you prefer "any tag" matching

    function applyFilter() {
      if (!list) return;
      const active = currentTags();
      for (const li of Array.from(list.children)) {
        const tags = getPostTags(li);
        const ok =
          active.length === 0
            ? true
            : MODE === 'AND'
            ? active.every(t => tags.includes(t))
            : active.some(t => tags.includes(t));
        li.style.display = ok ? '' : 'none';
      }
    }

    checks.forEach(c => c.addEventListener('change', applyFilter));

    // run once on load
    applyFilter();
  </script>
</Base>