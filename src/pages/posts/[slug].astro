---
import Base from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((p) => ({
    params: { slug: p.slug },
    props: { entry: p },
  }));
}

const { entry } = Astro.props;
if (!entry) {
  throw new Error("Post not found. Check that the slug and route match your MDX filename.");
}

const { Content } = await entry.render();

function fmt(d?: string | Date) {
  if (!d) return "";
  const dt = new Date(d);
  return dt.toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" });
}
---
<Base title={`${entry.data?.title ?? "Post"} — Scott Marriage`} description={entry.data?.description}>
  <Container class="py-16">
    <div class="mb-8 flex items-center justify-between gap-4">
      <a href="/posts" class="text-sm text-ink-muted hover:text-brand-500" aria-label="Back to posts">
        &larr; Posts
      </a>
      <span class="font-mono text-xs text-ink-faint whitespace-nowrap">{fmt(entry.data?.date)}</span>
    </div>
    <h1 class="font-display text-h1 font-semibold text-ink">{entry.data?.title}</h1>
    <article class="prose mt-8 max-w-none">
      <Content />
    </article>
  </Container>
</Base>
