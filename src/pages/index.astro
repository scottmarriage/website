
---
import Base from "../layouts/BaseLayout.astro";
---
<Base>
  <section class="grid md:grid-cols-2 gap-8 items-center">
    <div>
      <h1 class="text-4xl md:text-5xl font-bold leading-tight">
        Hi, I'm Scott!
      </h1>
      <h2 class="font-bold leading-tight mt-2">
        I'm a <span class="text-brand">Software Engineer</span> & <span class="text-brand">Data Scientist</span>
      </h2>
      <p class="mt-4 text-slate-300">
        I build fast, accessible interfaces and craft data-driven experiences. Explore interactive demos and real-world projects.
      </p>
    </div>
    <div class="card p-3 w-fit self-start justify-self-end">
      <h2 class="font-semibold mb-2">Featured Project Demos</h2>
    </div>
  </section>
</Base>
