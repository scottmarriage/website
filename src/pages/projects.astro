
---
import Base from "../layouts/BaseLayout.astro";
import { getCollection } from 'astro:content';
const projects = await getCollection('projects');
---
<Base title="Projects">
  <h1 class="text-3xl font-bold mb-6">Projects</h1>
  <p class="text-slate-300 mb-8">Placeholders are here for now. Populate with projects when ready.</p>
  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
    {projects.map(p => (
      <a href={`/projects/${p.slug}/`} class="card p-5 hover:border-slate-600 transition">
        <h3 class="font-semibold">{p.data.title}</h3>
        <p class="text-sm text-slate-400 mt-1">{p.data.description}</p>
        <div class="mt-3 flex gap-2 flex-wrap">
          {(p.data.tech || []).map(t => <span class="px-2 py-1 text-xs rounded-full bg-slate-800/80 border border-slate-700">{t}</span>)}
        </div>
      </a>
    ))}
  </div>
</Base>
