---
import Base from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<Base title="Projects — Scott Marriage" description="Projects I've built and am building — cloud infrastructure, data pipelines, and this site itself.">
  <Container class="py-16">
    <SectionHeading
      eyebrow="Projects"
      title="Things I've built"
      description="A mix of finished work and in-progress builds. Nothing here is fabricated — status badges reflect where each project actually stands."
    />
    <div class="mt-10">
      <ProjectGrid projects={projects} />
    </div>
  </Container>
</Base>
