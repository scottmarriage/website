
---
import "../styles/global.css";
import { FaLinkedin, FaGithub } from "react-icons/fa";
import { SiGooglescholar } from "react-icons/si";
const { title = "Scott Marriage — Software Engineer & Data Scientist", description = "Portfolio and live demos." } = Astro.props;
---
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
<header class="sticky top-0 z-40 backdrop-blur bg-slate-950/70 border-b border-slate-800">
  <nav class="mx-auto max-w-6xl px-4 py-3 flex items-center justify-between">
    <a href="/" class="font-semibold tracking-tight flex items-center gap-2">
      Scott Marriage
    </a>
    <div class="flex items-center gap-4 text-slate-400">
      <a
        href="https://www.linkedin.com/in/scott-marriage/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex hover:text-brand"
        aria-label="LinkedIn"
      >
        <FaLinkedin size={24} />
      </a>
      <a
        href="https://github.com/scottmarriage/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex hover:text-brand"
        aria-label="GitHub"
      >
        <FaGithub size={24} />
      </a>
      <a
        href="https://scholar.google.com/citations?user=1m5kJm8AAAAJ"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex hover:text-brand"
        aria-label="Google Scholar"
      >
        <SiGooglescholar size={24} />
      </a>
    </div>
    <div class="space-x-4 text-sm">
      <a href="/projects">Projects</a>
      <a href="/showcase">Skills Showcase</a>
      <a href="/posts">Posts</a>
      <a href="/contact">Contact</a>
    </div>
  </nav>
</header>
    <main class="mx-auto max-w-6xl px-4 py-8">
      <slot />
    </main>
    <footer class="border-t border-slate-800 py-10 text-center text-sm text-slate-400">
      © {new Date().getFullYear()} Scott Marriage
    </footer>
  </body>
</html>
