---
import Base from "./BaseLayout.astro";
import Container from "../components/Container.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { FaGithub, FaExternalLinkAlt } from "react-icons/fa";

const { frontmatter } = Astro.props;
const { title, description, tech, github, demo, status } = frontmatter;
---
<Base title={`${title} — Scott Marriage`} description={description}>
  <Container class="py-16">
    <a href="/projects" class="text-sm text-ink-muted hover:text-brand-500" aria-label="Back to projects">
      &larr; Projects
    </a>
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
      <h1 class="font-display text-h1 font-semibold text-ink">{title}</h1>
      {status && <StatusBadge status={status} />}
    </div>
    {description && <p class="mt-3 max-w-2xl text-ink-muted">{description}</p>}
    <div class="mt-4 flex flex-wrap gap-2">
      {(tech || []).map((t: string) => (
        <span class="rounded-full border border-border bg-surface-subtle px-2.5 py-0.5 font-mono text-xs text-ink-muted">
          {t}
        </span>
      ))}
    </div>
    {(github || demo) && (
      <div class="mt-4 flex gap-5 text-sm">
        {github && (
          <a href={github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-ink-muted hover:text-brand-500">
            <FaGithub /> Code
          </a>
        )}
        {demo && (
          <a href={demo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-ink-muted hover:text-brand-500">
            <FaExternalLinkAlt size={12} /> Live demo
          </a>
        )}
      </div>
    )}
    <article class="prose mt-10 max-w-none">
      <slot />
    </article>
  </Container>
</Base>
